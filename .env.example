# Global Configuration
LOG_LEVEL=INFO

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudpros
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/cloudpros

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Products Service
PRODUCTS_BASE=http://products:8001
PRODUCTS_DB_PATH=/data/products.db
SEED_FROM_FAKESTORE=1

# Carts Service
CARTS_BASE=http://carts:8002

# Orders Service
ORDERS_BASE=http://orders:8004

# Users Service
USERS_BASE=http://users:8015
JWT_SECRET=your-secret-key-change-in-production
JWT_TTL_HOURS=24